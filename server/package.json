{
  "name": "arede-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API for the Arede online store (Express + MySQL)",
  "scripts": {
    "start": "node src/index.js",
    "predev": "npm audit fix --no-fund --loglevel=error || true",
    "dev": "node --watch src/index.js",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate": "node scripts/migrate.js",
    "import": "node scripts/import-products.js",
    "db:reset": "node scripts/setup-db.js --fresh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.1.1"
  },
  "optionalDependencies": {
    "sharp": "^0.35.5"
  }
}
