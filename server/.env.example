# Copy this file to .env and fill it in.

PORT=5001
CLIENT_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=arede

# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created by `npm run db:setup`
ADMIN_NAME=Arede Admin
ADMIN_EMAIL=admin@arede.com
ADMIN_PASSWORD=ChangeThisPassword123

# Paystack. Use the TEST secret key (sk_test_...) while building, the LIVE key (sk_live_...) when you launch.
# Find it in your Paystack dashboard under Settings > API Keys & Webhooks. Never share or publish it.
PAYSTACK_SECRET_KEY=

# Where customers return after paying. For now it is your local site; later, your real domain.
PUBLIC_URL=http://localhost:5173

# Unpaid orders are cancelled and their items released after this many minutes
UNPAID_HOLD_MINUTES=30

# Delivery fee in naira, within Ibadan and outside it. Pickup is free.
DELIVERY_FEE_IBADAN=3000
DELIVERY_FEE_OUTSIDE=4000

# Get an email when an order is paid (optional). For Gmail: turn on 2-step verification, then create an
# "App password" at myaccount.google.com/apppasswords and paste it as SMTP_PASS (not your normal password).
NOTIFY_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
